# Kopjoje si .env. Zëvendëso çelësat para se të ruash të dhëna reale pacientësh.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Gjenero me:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# postgres (docker compose) ose sqlite për provë lokale pa Docker
DB_ENGINE=postgres
POSTGRES_DB=psycare
POSTGRES_USER=psycare
POSTGRES_PASSWORD=psycare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SMS për kodet e pacientëve. Në zhvillim kodi shtypet në terminalin e Django-s.
# Për SMS reale: SMS_BACKEND=core.sms.TwilioSMSBackend dhe tre variablat TWILIO_*.
SMS_BACKEND=core.sms.ConsoleSMSBackend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
